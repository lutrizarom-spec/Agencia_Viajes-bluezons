classDiagram
direction TB

class Persona {
    -rut: String
    -nombre: String
    -telefono_movil: String
    +validar_datos(): boolean
}

class Cliente {
    -id_cliente: int
    -pasaporte: String
    -correo: String
    +validar_pasaporte(): boolean
}

class Paquete_Turistico {
    -codigo: int
    -nombre: String
    -duracion: int
    -precio_base: double
    +calcular_precio(tasa_cambio: double): double
    +obtener_detalle(): String
}
<<abstract>> Paquete_Turistico

class Paquete_Nacional {
    +calcular_precio(tasa_cambio: double): double
}

class Paquete_Internacional {
    -pasaporte_valido: boolean
    +calcular_precio(tasa_cambio: double): double
}

class Paquete_Crucero {
    -impuesto_puerto: double
    +calcular_precio(tasa_cambio: double): double
}

class Servicio_Turistico {
    -id_servicio: int
    -nombre: String
    -destino: String
    -zona: String
    -precio_base: double
    +obtener_precio(): double
}
<<abstract>> Servicio_Turistico

class Hotel_Estancia {
    -noches: int
}

class Linea_Vuelo {
    -aerolinea: String
}

class Excursion {
    -duracion_horas: int
}

class Seguro {
    -cobertura: String
}

class Reserva {
    -numero_reserva: String
    -fecha_reserva: Date
    -fecha_viaje: Date
    -estado: String
    -tasa_cambio_aplicada: double
    +agregar_detalle(cantidad: int): Detalle_Reserva
    +agregar_servicio(servicio: Servicio_Turistico, cantidad: int): Detalle_Reserva
    +confirmar(): boolean
    +cancelar(): boolean
    +validar_anticipo(monto: double): boolean
    +calcular_total(): double
}

class Detalle_Reserva {
    -id_detalle: int
    -cantidad: int
    -subtotal: double
    +calcular_subtotal(): double
}

class Pago {
    -id_pago: String
    -fecha: Date
    -monto: double
    -estado: String
    -fecha_vencimiento: Date
    +procesar_pago(): void
}

class Boleta {
    -num_boleta: int
    -fecha: Date
    -monto: double
    -emitida: boolean
    +emitir(): void
}

Persona <|-- Cliente
Paquete_Turistico <|-- Paquete_Nacional
Paquete_Turistico <|-- Paquete_Internacional
Paquete_Turistico <|-- Paquete_Crucero
Servicio_Turistico <|-- Hotel_Estancia
Servicio_Turistico <|-- Linea_Vuelo
Servicio_Turistico <|-- Excursion
Servicio_Turistico <|-- Seguro

Cliente "1" -- "0..*" Reserva : solicita
Reserva "0..*" -- "1" Paquete_Turistico : origina
Reserva "1" *-- "0..*" Detalle_Reserva : incluye
Detalle_Reserva "0..*" -- "1" Paquete_Turistico : refiere paquete
Detalle_Reserva "0..*" -- "1" Servicio_Turistico : refiere servicio
Reserva "1" -- "1..*" Pago : recibe
Pago "1" *-- "1" Boleta : genera

note for Reserva "Dominio/consola: este modelo POO se persiste con ReservaDao y lo usa main.py. La API operativa no usa estas clases; CompraService guarda en reservas/payments/package_inventory."
note for Pago "Estados del dominio: pendiente/confirmado/fallido; la API los persiste como pending/confirmed/failed."
note for Paquete_Internacional "pasaporte_valido es informativo; la exigencia real depende del tipo internacional y del pasaporte del cliente."
