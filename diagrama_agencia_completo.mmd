%% BORRADOR: basado unicamente en los nombres y reglas mencionados en la conversacion.
%% Los miembros y multiplicidades marcados como pendientes requieren cotejo con el informe 2 original.
classDiagram
direction TB

class Persona {
  %% Atributos y operaciones no disponibles en el material revisado.
}

class Cliente {
  +validar_pasaporte(): tipo_pendiente
}

class Empleado {
  %% Atributos y operaciones no disponibles en el material revisado.
}

