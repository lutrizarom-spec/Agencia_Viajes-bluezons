  +aprobar_pago(): tipo_pendiente
}

class Agente_Viajes {
  +atender_cliente(): tipo_pendiente
}

class Paquete_Turistico {
  -codigo: tipo_pendiente
  +calcular_precio(): tipo_pendiente
}
<<abstract>> Paquete_Turistico

class Paquete_Nacional {
  %% Miembros propios pendientes de cotejo.
}

class Paquete_Internacional {
  %% Miembros propios pendientes de cotejo.
}

class Paquete_Crucero {
  %% Miembros propios pendientes de cotejo.
}

