  -tasa_cambio_aplicada: tipo_pendiente
  +crear_reserva(): tipo_pendiente
  +calcular_total(): tipo_pendiente
  +validar_anticipo(): tipo_pendiente
}

class Pago {
  +procesar_pago(): tipo_pendiente
}

class Boleta {
  +emitir(): tipo_pendiente
}

class Proveedor {
  %% cupos_disponibles se modela por fecha en Cupo, no como un total unico.
}

