classDiagram
direction TB

class Persona {
    -rut: String
    -nombre: String
    -telefono_movil: String
    +validar_datos(): boolean
}

class Cliente {
    -id_cliente: int
    -pasaporte: String
    -correo: String
    +validar_pasaporte(): boolean
    +solicitar_reserva(): boolean
    +consultar_itinerario(): String
}

class Empleado {
    -id_empleado: int
}

class Administrador {
    +gestionar_proveedor(): void
    +aprobar_pago(): void
}

class Agente_Viajes {
    +atender_cliente(): void
    +crear_reserva(): boolean
    +vender_paquete(): boolean
}

class Paquete_Turistico {
    -codigo: int
    -nombre: String
    -duracion: int
    -precio_base: double
    +obtener_detalle(): String
    +calcular_precio(tasa_cambio: double): double
}
<<abstract>> Paquete_Turistico

class Paquete_Nacional {
    +calcular_precio(tasa_cambio: double): double
}

class Paquete_Internacional {
    -pasaporte_valido: boolean
    +calcular_precio(tasa_cambio: double): double
}

class Paquete_Crucero {
    -impuesto_puerto: double
    +calcular_precio(tasa_cambio: double): double
}

class Servicio_Turistico {
    -id_servicio: int
    -nombre: String
    -destino: String
    -zona: String
    -precio_base: double
    +obtener_precio(): double
}
<<abstract>> Servicio_Turistico

class Hotel_Estancia {
    -noches: int
    +obtener_precio(): double
}

class Linea_Vuelo {
    -aerolinea: String
    +obtener_precio(): double
}

class Excursion {
    -duracion_horas: int
    +obtener_precio(): double
}

class Seguro {
    -cobertura: String
    +obtener_precio(): double
}

class Reserva {
    -numero_reserva: String
    -fecha_reserva: Date
    -fecha_viaje: Date
    -estado: String
    -total: double
    -tasa_cambio_aplicada: double
    +confirmar(): boolean
    +cancelar(): boolean
    +validar_anticipo(): boolean
    +calcular_total(): double
}

class Detalle_Reserva {
    -id_detalle: int
    -cantidad: int
    -subtotal: double
    +calcular_subtotal(): double
}

class Tipo_Cambio {
    -fecha: Date
    -valor_dolar: double
    +obtener_valor(): double
}

class Pago {
    -id_pago: String
    -fecha: Date
    -monto: double
    -estado: String
    -fecha_vencimiento: Date
    +procesar_pago(): void
}

class Boleta {
    -num_boleta: int
    -fecha: Date
    -monto: double
    +emitir(): void
}

class Proveedor {
    -id_proveedor: int
    -nombre: String
    +verificar_disponibilidad(fecha: Date): boolean
}

class Cupo {
    -fecha: Date
    -cupos_totales: int
    -cupos_reservados: int
    +cupos_disponibles(): int
}

Persona <|-- Cliente
Persona <|-- Empleado
Empleado <|-- Administrador
Empleado <|-- Agente_Viajes

Paquete_Turistico <|-- Paquete_Nacional
Paquete_Turistico <|-- Paquete_Internacional
Paquete_Turistico <|-- Paquete_Crucero

Servicio_Turistico <|-- Hotel_Estancia
Servicio_Turistico <|-- Linea_Vuelo
Servicio_Turistico <|-- Excursion
Servicio_Turistico <|-- Seguro

Cliente "1" -- "0..*" Reserva : solicita
Agente_Viajes "1" -- "0..*" Reserva : crea
Reserva "0..*" -- "1" Paquete_Turistico : origina
Reserva "1" *-- "0..*" Detalle_Reserva : incluye
Detalle_Reserva "0..*" -- "1" Servicio_Turistico : refiere
Reserva "1" -- "1..*" Pago : recibe
Pago "1" *-- "1" Boleta : genera

Administrador "1" -- "0..*" Proveedor : gestiona
Administrador "1" ..> Pago : aprueba
Proveedor "1" -- "0..*" Servicio_Turistico : provee
Paquete_Turistico "1" -- "0..*" Cupo : disponibiliza por fecha
Reserva "0..*" -- "1" Cupo : reserva para su fecha de viaje
Reserva ..> Tipo_Cambio : congela la tasa obtenida al reservar

note for Reserva "La reserva almacena la tasa USD/CLP aplicada. Se crea con un pago inicial pendiente del 50%; los abonos posteriores se acumulan hasta completar el saldo."
note for Cupo "La disponibilidad se mantiene por paquete y fecha de viaje; reservar, cancelar o vencer un pago actualiza solo esa fecha."